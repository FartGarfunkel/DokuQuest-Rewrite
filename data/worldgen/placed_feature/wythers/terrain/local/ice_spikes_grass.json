{
  "feature": {
    "type": "main:disk",
    "config": {
      "state_provider": {
        "fallback": {
          "type": "main:simple_state_provider",
          "state": {
            "Name": "main:coarse_dirt"
          }
        },
        "rules": [
          {
            "if_true": {
              "type": "main:matching_blocks",
              "offset": [
                0,
                1,
                0
              ],
              "blocks": "main:snow"
            },
            "then": {
              "type": "main:simple_state_provider",
              "state": {
                "Name": "main:grass_block",
                "Properties": {
                  "snowy": "true"
                }
              }
            }
          },
          {
            "if_true": {
              "type": "main:matching_blocks",
              "offset": [
                0,
                1,
                0
              ],
              "blocks": [
                "main:air"
              ]
            },
            "then": {
              "type": "main:simple_state_provider",
              "state": {
                "Name": "main:grass_block",
                "Properties": {
                  "snowy": "false"
                }
              }
            }
          }
        ]
      },
      "target": {
        "type": "main:matching_blocks",
        "blocks": "main:snow_block"
      },
      "radius": {
        "type": "main:uniform",
        "value": {
          "min_inclusive": 3,
          "max_inclusive": 7
        }
      },
      "half_height": 4
    }
  },
  "placement": [
    {
      "type": "main:count",
      "count": 30
    },
    {
      "type": "main:height_range",
      "height": {
        "absolute": 0
      }
    },
    {
      "type": "main:in_square"
    },
    {
      "type": "main:surface_relative_threshold_filter",
      "heightmap": "WORLD_SURFACE_WG",
      "min_inclusive": -85,
      "max_inclusive": -50
    },
    {
      "type": "main:heightmap",
      "heightmap": "WORLD_SURFACE_WG"
    },
    {
      "type": "main:biome"
    }
  ]
}
