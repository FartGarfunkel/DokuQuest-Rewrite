{
  "feature": {
    "type": "main:disk",
    "config": {
      "state_provider": {
        "fallback": {
          "type": "main:simple_state_provider",
          "state": {
            "Name": "main:grass_block",
            "Properties": {
              "snowy": "false"
            }
          }
        },
        "rules": [
          {
            "if_true": {
              "type": "main:matching_blocks",
              "offset": [
                0,
                1,
                0
              ],
              "blocks": "main:stone"
            },
            "then": {
              "type": "main:simple_state_provider",
              "state": {
                "Name": "main:stone"
              }
            }
          },
          {
            "if_true": {
              "type": "main:not",
              "predicate": {
                "type": "main:matching_blocks",
                "offset": [
                  0,
                  1,
                  0
                ],
                "blocks": [
                  "main:air",
                  "main:snow",
                  "main:grass"
                ]
              }
            },
            "then": {
              "type": "main:simple_state_provider",
              "state": {
                "Name": "main:coarse_dirt"
              }
            }
          }
        ]
      },
      "target": {
        "type": "main:matching_blocks",
        "blocks": [
          "main:snow_block",
          "main:powder_snow",
          "main:coarse_dirt"
        ]
      },
      "radius": {
        "type": "main:uniform",
        "value": {
          "min_inclusive": 8,
          "max_inclusive": 8
        }
      },
      "half_height": 4
    }
  },
  "placement": [
    {
      "type": "main:count",
      "count": 30
    },
    {
      "type": "main:in_square"
    },
    {
      "type": "main:heightmap",
      "heightmap": "OCEAN_FLOOR"
    },
    {
      "type": "main:biome"
    }
  ]
}
