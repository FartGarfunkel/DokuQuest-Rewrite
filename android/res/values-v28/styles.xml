<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 9+: the game fills the whole screen, round the camera hole too (by default Android keeps a black bar
         beside it in landscape). The touch controls are placed from the window's own size, so they move out with it. -->
    <style name="AppTheme" parent="android:Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
